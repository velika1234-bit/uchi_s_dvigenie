rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidScenario(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.gameType is string &&
             data.interactionType is string &&
             data.items is list && data.items.size() > 0;
    }

    match /scenarios/{scenarioId} {
      // Allow everyone to read scenarios so students can play
      allow read: if true;
      
      // Allow authenticated users to create/update/delete scenarios
      // For this prototype, we'll allow any authenticated user to manage scenarios
      allow create: if isAuthenticated() && isValidScenario(request.resource.data);
      allow update: if isAuthenticated() && isValidScenario(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
